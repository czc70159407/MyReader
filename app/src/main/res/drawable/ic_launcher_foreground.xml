<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive Icon 前景：实心「打开的书」，两页对称、中间书脊留白（奶油白，无渐变/无阴影）。
     画布 108x108dp，图形收在中心可见圆（半径 36dp）内并留边距（图形约占可见区 62%），
     兼容圆形/圆角方形掩码；同一 drawable 复用为 <monochrome> 层（实心即 alpha=1 的书本剪影，
     Android 13+ 由系统按壁纸染色）。造型与色值见 docs/design/tokens.md §1.1。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 左页：书脊处高、外缘略收，形成张开的透视感 -->
    <path
        android:pathData="M51,45 C46,40 39,38 32,39 L32,68 C39,67 46,69 51,73 Z"
        android:fillColor="@color/ic_launcher_foreground" />

    <!-- 右页：与左页镜像，中间 6dp 书脊缝 -->
    <path
        android:pathData="M57,45 C62,40 69,38 76,39 L76,68 C69,67 62,69 57,73 Z"
        android:fillColor="@color/ic_launcher_foreground" />

    <!-- 书脊底部连接块：底缘用二次贝塞尔收成圆弧，与两页下凸曲线连贯，避免尖角/直角台阶 -->
    <path
        android:pathData="M51,66 L57,66 Q57,72.6 54,72.6 Q51,72.6 51,66 Z"
        android:fillColor="@color/ic_launcher_foreground" />
</vector>
